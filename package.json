{
  "name": "shaka-ts-toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "Transpiles a pinned Shaka Player release from Closure annotated JavaScript into TypeScript. The published shaka-ts package is generated into dist/package by this toolchain.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Julian Tellez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliantellez/shaka-ts.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:roundtrip": "node --experimental-strip-types src/verify-roundtrip.ts",
    "verify:graph": "node --experimental-strip-types src/verify-graph.ts",
    "build": "node --experimental-strip-types src/build.ts",
    "bump": "node --experimental-strip-types src/bump.ts",
    "verify:upstream": "node --experimental-strip-types src/verify-upstream.ts",
    "checksum:update": "node --experimental-strip-types src/verify-upstream.ts --update",
    "verify:size": "node --experimental-strip-types src/verify-size.ts",
    "verify:licenses": "node --experimental-strip-types src/verify-licenses.ts",
    "verify:dts": "node --experimental-strip-types src/verify-dts.ts",
    "test:oracle": "vitest run --config vitest.oracle.config.ts",
    "test:suite": "node --experimental-strip-types src/suite.ts",
    "verify:checkjs": "node --experimental-strip-types src/verify-checkjs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "happy-dom": "^20.11.1",
    "jasmine-core": "^6.3.0",
    "jiti": "^2.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "prettier": "^3.4.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
